# =============================================================================
# DJVPN Cabinet — конфигурация
# Скопируй в .env и заполни значения
# =============================================================================

# -----------------------------------------------------------------------------
# Docker: имя внешней сети SHM (узнать: docker network ls | grep shm)
# -----------------------------------------------------------------------------
SHM_NETWORK=shm_default

# -----------------------------------------------------------------------------
# SHM API
# -----------------------------------------------------------------------------
# Внутренний адрес SHM (по имени контейнера в Docker-сети)
SHM_BASE_URL=http://api

# Публичный URL SHM для страницы оплаты (tg_payment_webapp)
# Если nginx проксирует /shm/ на тот же домен — указывай домен кабинета
SHM_PUBLIC_URL=https://bill.djvpn.ru

# Учётка администратора SHM
SHM_ADMIN_LOGIN=admin
SHM_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# JWT (сессии пользователей)
# -----------------------------------------------------------------------------
# Минимум 32 символа, генерируй случайно: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_EXPIRE_SECONDS=2592000

# -----------------------------------------------------------------------------
# Telegram Login Widget
# TELEGRAM_BOT_USERNAME — отображается в виджете входа, берётся из .env в рантайме
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=DJ_VPN_bot

# -----------------------------------------------------------------------------
# CORS — домены, с которых открывается кабинет
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=["https://bill.djvpn.ru"]

# -----------------------------------------------------------------------------
# Remnawave HWID — управление устройствами
# -----------------------------------------------------------------------------
# Базовый URL Remnawave API (без слеша на конце)
REMNA_BASE_URL=https://vpn.example.com
# Bearer-токен для авторизации в Remnawave API
REMNA_TOKEN=

# -----------------------------------------------------------------------------
# Uptime Kuma — публичная страница статуса серверов
# -----------------------------------------------------------------------------
KUMA_STATUS_URL=https://kuma.djvpn.ru/status/djvpn

# -----------------------------------------------------------------------------
# PostgreSQL (используется для настроек кабинета, корзины и inbox-уведомлений)
# Если оставить DATABASE_URL пустым — бэкенд работает stateless как раньше.
# -----------------------------------------------------------------------------
POSTGRES_DB=shmcabinet
POSTGRES_USER=shmcabinet
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://shmcabinet:change-me@postgres:5432/shmcabinet
