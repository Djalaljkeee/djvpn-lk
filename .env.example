# =============================================================================
# DJVPN Cabinet — конфигурация
# Скопируй в .env и заполни значения
# =============================================================================

# -----------------------------------------------------------------------------
# SHM API — внешний адрес. Фронт ходит через /api/shm/* (backend-прокси),
# backend форвардит запросы сюда и переписывает Set-Cookie на свой домен,
# чтобы cookie session_id жила same-origin на ЛК. SHM напрямую с фронта
# не дёргается — без прокси упёрлись бы в cross-origin CORS + cookie.
# -----------------------------------------------------------------------------
SHM_BASE_URL=https://admin.djvpn.ru

# Платёжный шлюз SHM (фронт строит ссылки оплаты как
# {SHM_BILL_URL}/shm/pay_systems/{ps}.cgi?action=create&...).
SHM_BILL_URL=https://bill.djvpn.ru

# -----------------------------------------------------------------------------
# Telegram Login Widget
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=DJ_VPN_bot

# -----------------------------------------------------------------------------
# CORS — домены, с которых открывается кабинет. Фронт ЛК ходит на backend
# same-origin (через nginx), так что внешние Origin сюда попадают только
# из bill (платёжный шлюз) и/или прямых API-клиентов.
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=["https://bill.djvpn.ru"]

# -----------------------------------------------------------------------------
# Remnawave HWID — управление устройствами
# -----------------------------------------------------------------------------
REMNA_BASE_URL=https://vpn.example.com
REMNA_TOKEN=

# -----------------------------------------------------------------------------
# Uptime Kuma — публичная страница статуса серверов
# -----------------------------------------------------------------------------
KUMA_STATUS_URL=https://kuma.djvpn.ru/status/djvpn

# -----------------------------------------------------------------------------
# PostgreSQL (cart + inbox-уведомления)
# -----------------------------------------------------------------------------
POSTGRES_DB=shmcabinet
POSTGRES_USER=shmcabinet
POSTGRES_PASSWORD=change-me
DB_REQUIRED=True

# -----------------------------------------------------------------------------
# Redis (кеш Remnawave + rate-limit). Пусто = in-memory fallback.
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Чат поддержки в кабинете ---
# Мост к боту поддержки живёт во внутренней docker-сети shm-cabinet.
# SUPPORT_BRIDGE_SECRET должен совпадать с lk_bridge.secret в конфиге бота.
SUPPORT_CHAT_ENABLED=false
SUPPORT_BRIDGE_URL=http://support-bot:8081
SUPPORT_BRIDGE_SECRET=
SUPPORT_RETENTION_DAYS=180
# Дубль ответа в @DJ_VPN_bot, если клиент ушёл из кабинета (бот поддержки
# написать первым не может — клиент не нажимал у него /start).
SUPPORT_TG_FANOUT=true
SUPPORT_FANOUT_DELAY_S=90
SUPPORT_LK_URL=https://lk.djvpn.ru
