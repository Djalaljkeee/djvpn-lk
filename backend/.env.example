# SHM billing — внутренний адрес (Docker сеть)
SHM_BASE_URL=http://api
# Публичный URL SHM, доступный из браузера (для кнопки оплаты через webapp)
# Если SHM проксируется через тот же nginx, что и кабинет:
SHM_PUBLIC_URL=https://bill.djvpn.ru
SHM_ADMIN_LOGIN=admin
SHM_ADMIN_PASSWORD=admin

# JWT (минимум 32 символа)
JWT_SECRET=change-me-in-production-use-32-chars-min
JWT_EXPIRE_SECONDS=2592000

# Telegram (получить у @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# CORS — домены откуда открывается фронт
ALLOWED_ORIGINS=["https://bill.djvpn.ru"]

# Remnawave HWID — управление устройствами
REMNA_BASE_URL=https://vpn.example.com
REMNA_TOKEN=

# Uptime Kuma — страница статуса серверов (публичная)
KUMA_STATUS_URL=https://kuma.djvpn.ru/status/djvpn

# PostgreSQL: пусто = БД выключена, бэкенд работает stateless (как раньше).
# Формат: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=

# Redis: пусто = кеш и rate-limit ведутся in-memory (один воркер).
# Формат: redis://redis:6379/0
REDIS_URL=

# Rate limiting
RATE_LIMIT_ENABLED=True
# Глобальный лимит на все эндпоинты (пусто = без общего лимита, только точечные).
RATE_LIMIT_DEFAULT=

# Observability
# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# В проде — JSON. Для локальной разработки можно выставить False.
LOG_JSON=True
# Sentry: оставьте пустым, чтобы отключить
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Доля трассировок (0..1). 0 = выключено.
SENTRY_TRACES_SAMPLE_RATE=0.0
