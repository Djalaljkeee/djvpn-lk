# SHM billing URL
# Если SHM на той же VM — используй host.docker.internal:
SHM_BASE_URL=http://host.docker.internal:3001
SHM_ADMIN_LOGIN=admin
SHM_ADMIN_PASSWORD=admin

# JWT (минимум 32 символа)
JWT_SECRET=change-me-in-production-use-32-chars-min
JWT_EXPIRE_SECONDS=2592000

# Telegram (получить у @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# CORS — домены откуда открывается фронт
# Если за nginx на 80 порту:
ALLOWED_ORIGINS=["http://YOUR_VM_IP", "https://YOUR_DOMAIN"]
