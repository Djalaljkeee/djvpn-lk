# SHM billing — внутренний адрес (Docker сеть)
SHM_BASE_URL=http://api
# Публичный URL SHM, доступный из браузера (для кнопки оплаты через webapp)
# Если SHM проксируется через тот же nginx, что и кабинет:
SHM_PUBLIC_URL=https://bill.djvpn.ru
SHM_ADMIN_LOGIN=admin
SHM_ADMIN_PASSWORD=admin

# JWT (минимум 32 символа)
JWT_SECRET=change-me-in-production-use-32-chars-min
JWT_EXPIRE_SECONDS=2592000

# Telegram (получить у @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# CORS — домены откуда открывается фронт
ALLOWED_ORIGINS=["https://bill.djvpn.ru"]

# Remnawave HWID — управление устройствами
REMNA_BASE_URL=https://vpn.example.com
REMNA_TOKEN=
